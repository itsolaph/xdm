<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. allowBackup="false" already stops cloud backups, but not device-to-device transfers: the private
     folder and its PIN must not travel either way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="private/" />
        <exclude domain="file" path="datastore/vault.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="private/" />
        <exclude domain="file" path="datastore/vault.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
