<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only. The emulator smoke test in CI starts this activity from the shell
            (am start with the string extra "id" set to a video id) and reads the YTTEST line it logs.
            Exported on purpose so that am start works.
        -->
        <activity
            android:name=".debug.YoutubeTestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="YouTube self-test" />
        <!--
            Debug builds only: private folder + player self-test, started from the shell with
            am start -n com.olaph.xdm/.debug.VaultTestActivity; it logs one VAULTTEST line. Exported for the same reason.
        -->
        <activity
            android:name=".debug.VaultTestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Private folder self-test" />
    </application>
</manifest>
